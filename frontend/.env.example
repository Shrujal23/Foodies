# Foodies — frontend environment (copy to .env and fill in)
#   cp .env.example .env
#
# Safe to commit. Real .env is gitignored.
#
# NOTE: Any REACT_APP_* value is embedded in the browser bundle.
# Do not put private secrets here. API keys for Edamam/Groq
# belong in backend/.env only.
# ============================================================

# --- Local API (default) ---
# REACT_APP_API_URL=http://localhost:5000/api
# REACT_APP_API_BASE=http://localhost:5000

# --- Deployed API (uncomment when frontend talks to EC2/backend host) ---
# REACT_APP_API_URL=http://YOUR_EC2_HOST:5000/api
# REACT_APP_API_BASE=http://YOUR_EC2_HOST:5000

# Optional: only if you still use a client-side Edamam fallback.
# Prefer server-side keys in backend/.env for real search.
# REACT_APP_EDAMAM_APP_ID=
# REACT_APP_EDAMAM_APP_KEY=
