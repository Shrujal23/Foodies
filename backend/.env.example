# ============================================================
# Foodies — backend environment (copy to .env and fill in)
#   cp .env.example .env
#
# This file is safe to commit. NEVER put real secrets here.
# Your real secrets stay in backend/.env (gitignored).
# ============================================================

# --- Required secrets (generate long random strings) ---
JWT_SECRET=change_me_to_a_long_random_string
SESSION_SECRET=change_me_to_another_long_random_string

# --- Server ---
PORT=5000
# NODE_ENV=development
# NODE_ENV=production

# Optional cookie flags for cross-site deploy (Vercel frontend + remote API)
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

# ============================================================
# MySQL — toggle LOCAL vs AWS
# Only ONE host block should be active (uncommented) at a time.
# Comment the block you are not using.
# ============================================================

# --- LOCAL MySQL (default for day-to-day dev) ---
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_local_mysql_password
MYSQL_DATABASE=foodies
# MYSQL_PORT=3306

# --- AWS RDS (uncomment when using cloud DB; comment LOCAL block above) ---
# MYSQL_HOST=your-db.xxxxx.region.rds.amazonaws.com
# MYSQL_USER=admin
# MYSQL_PASSWORD=your_rds_password
# MYSQL_DATABASE=foodies
# MYSQL_PORT=3306

# ============================================================
# Third-party APIs (server-side — keep keys out of the frontend)
# ============================================================

# Edamam (recipe search)
EDAMAM_APP_ID=your_edamam_app_id
EDAMAM_APP_KEY=your_edamam_app_key

# Groq (AI chatbot "Foody")
GROQ_API_KEY=your_groq_api_key

# ============================================================
# OAuth (optional — leave empty if not using social login)
# ============================================================

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
